<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>{{ subject }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..700,0..100&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  /* Curio design system tokens
     Ink #1F1B16 · Spark #F26B3A · Oat #F4EDE1 · Paper #FBF7F0 · muted #6B6258 · border #E8DFD1 */
  body { margin:0; padding:0; background:#FBF7F0; font-family:'DM Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color:#1F1B16; line-height:1.6; }
  .wm { font-family:'Fraunces', Georgia, serif; font-variation-settings:'SOFT' 100, 'opsz' 144; letter-spacing:-0.03em; }

  /* Body prose styling (inside .curio) */
  .curio h1 { display:none; }
  .curio h2 {
    font-family:'DM Sans', system-ui, sans-serif;
    font-size:11px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:#6B6258;
    margin:36px 0 14px 0;
    padding:0 0 8px 0;
    border-bottom:1px solid #E8DFD1;
    font-weight:500;
  }
  .curio h2:first-child { margin-top:12px; }
  .curio h3 {
    font-family:'Fraunces', Georgia, serif;
    font-variation-settings:'SOFT' 100, 'opsz' 144;
    font-size:20px;
    letter-spacing:-0.015em;
    margin:22px 0 6px 0;
    color:#1F1B16;
    font-weight:600;
    line-height:1.3;
  }
  .curio p {
    margin:8px 0 14px 0;
    font-size:15.5px;
    line-height:1.7;
    color:#2A2620;
  }
  .curio p strong:first-child {
    color:#F26B3A;
    font-weight:700;
  }
  .curio a {
    color:#1F1B16;
    text-decoration:none;
    border-bottom:1.5px solid #F26B3A;
    padding-bottom:0.5px;
  }
  .curio a:hover { color:#F26B3A; }
  .curio strong a,
  .curio p > strong > a {
    color:#1F1B16;
    border-bottom:2px solid #F26B3A;
    font-weight:700;
  }
  .curio ul { padding-left:22px; margin:8px 0 16px 0; }
  .curio li { margin:6px 0; color:#2A2620; }
  .curio blockquote {
    border-left:3px solid #F26B3A;
    padding:2px 0 2px 16px;
    color:#5A5348;
    margin:16px 0;
    font-style:italic;
  }
  .curio code {
    background:#F4EDE1;
    padding:2px 6px;
    border-radius:4px;
    font-family:'SF Mono', Menlo, 'Courier New', monospace;
    font-size:13.5px;
    color:#5A5348;
  }
  .curio img {
    max-width:100%;
    height:auto;
    border-radius:8px;
    margin:14px 0;
    display:block;
  }
  .curio hr { border:0; border-top:1px solid #E8DFD1; margin:28px 0; }
  .curio em { color:#5A5348; }
</style>
</head>
<body>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#FBF7F0;">
  <tr>
    <td align="center" style="padding:32px 12px;">
      <table role="presentation" width="620" cellpadding="0" cellspacing="0" style="max-width:620px; background:#FFFFFF; border:1px solid #E8DFD1; border-radius:16px; overflow:hidden;">
        <!-- Masthead — newspaper-style centered header -->
        <tr>
          <td align="center" style="padding:44px 24px 20px 24px;">
            <img src="{{ mark_src }}" width="72" height="72" alt="Curio mark" style="display:block; margin:0 auto 12px auto; border:0;"/>
            <div class="wm" style="font-size:56px; font-weight:600; line-height:1; color:#1F1B16; margin-bottom:8px;">curio</div>
            <div style="font-family:'DM Sans', system-ui, sans-serif; font-size:14px; color:#6B6258; letter-spacing:0.04em;">
              your daily dose of curious
            </div>
          </td>
        </tr>

        <!-- Rule -->
        <tr>
          <td style="padding:8px 40px 0 40px;">
            <div style="border-top:2px solid #1F1B16; height:0; line-height:0;"></div>
            <div style="border-top:1px solid #1F1B16; height:0; margin-top:3px; line-height:0;"></div>
          </td>
        </tr>

        <!-- Metadata strip: date · deep dive -->
        <tr>
          <td style="padding:12px 40px 12px 40px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
              <tr>
                <td style="font-family:'DM Sans', system-ui, sans-serif; font-size:12px; letter-spacing:0.12em; color:#6B6258; text-transform:uppercase; font-weight:500;">
                  {{ weekday }}, {{ date_display }}
                </td>
                <td align="right">
                  {% if rotation_topic %}
                  <span style="display:inline-block; padding:5px 11px; background:#F4EDE1; border-radius:999px; font-family:'DM Sans', system-ui, sans-serif; font-size:11px; letter-spacing:0.12em; color:#6B6258; text-transform:uppercase; font-weight:500;">
                    Deep dive · <span style="color:#F26B3A; font-weight:600;">{{ rotation_topic }}</span>
                  </span>
                  {% endif %}
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Rule -->
        <tr>
          <td style="padding:0 40px;">
            <div style="height:1px; background:#E8DFD1;"></div>
          </td>
        </tr>

        <!-- Body -->
        <tr>
          <td style="padding:12px 32px 28px 32px;">
            <div class="curio">
              {{ body_html | safe }}
            </div>
          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td style="padding:18px 32px 24px 32px; background:#F4EDE1; border-top:1px solid #E8DFD1;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
              <td style="font-family:'DM Sans', system-ui, sans-serif; font-size:12px; color:#6B6258; letter-spacing:0.02em;">
                <span class="wm" style="font-weight:600; color:#1F1B16;">curio</span>
                &nbsp;·&nbsp; your daily dose of curious
              </td>
              <td align="right" style="font-family:'DM Sans', system-ui, sans-serif; font-size:11px; color:#8B7F70;">
                {{ generated_at }}
              </td>
            </tr></table>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
