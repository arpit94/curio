# Resend API — https://resend.com
# 1. Sign up, add your domain (e.g. arpitagg.me), add the DNS records they provide
# 2. Once verified, create an API key with "Sending access" scope
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The address the digest is sent from — must be on a verified domain.
# For pre-verification testing, Resend allows: onboarding@resend.dev (but only to
# the email address your Resend account is registered with).
DIGEST_FROM=curio@arpitagg.me

# Where the digest is delivered.
DIGEST_TO=you@example.com
